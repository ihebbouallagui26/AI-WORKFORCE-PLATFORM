# Optional per-developer overrides for `./mvnw spring-boot:run` (dev profile).
# The dev profile reads, in order: real environment variables, services/core-api/.env,
# then infra/docker/.env. Most developers only need infra/docker/.env (shared with Docker
# Compose). Copy this file to `.env` only to override values locally. Never commit `.env`.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_workforce
DB_USERNAME=app_user
DB_PASSWORD=

APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
