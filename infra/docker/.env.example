# Local development environment for infra/docker/compose.yaml and the Core API.
# Create `infra/docker/.env` with: bash infra/docker/scripts/ensure-env.sh
# (fills every missing secret with a random value, never overwrites existing values).
# `.env` files are ignored by Git.

# PostgreSQL bootstrap superuser (used only by the db-init container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_workforce
DB_USERNAME=app_user
DB_PASSWORD=

# Flyway migrations (DDL owner of the application schema)
DB_MIGRATION_USERNAME=aiw_migrator
DB_MIGRATION_PASSWORD=
# Core API runtime (data access only, no DDL)
DB_APP_USERNAME=aiw_app
DB_APP_PASSWORD=

# Keycloak (separate database and user)
KEYCLOAK_PORT=8082
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# OpenID Connect (Core API resource server)
OIDC_ISSUER=http://localhost:8082/realms/ai-workforce
OIDC_JWK_SET_URI=http://localhost:8082/realms/ai-workforce/protocol/openid-connect/certs
OIDC_AUDIENCE=ai-workforce-api

# Mail (Mailpit locally)
# AES-256 master key of the provider-credential secret store (base64 of 32 random bytes).
# Left empty here: ensure-env.sh generates one. Losing or changing it makes stored credentials unreadable.
SECRETS_MASTER_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# AI orchestrator (Phase C0): separate runtime database and restricted role (LangGraph checkpoints),
# and the OAuth2 client secret of its Keycloak service account (see infra/keycloak/README.md).
ORCHESTRATOR_DB_NAME=ai_orchestrator
ORCHESTRATOR_DB_USERNAME=aiw_orchestrator
ORCHESTRATOR_DB_PASSWORD=
ORCHESTRATOR_CLIENT_SECRET=
# The Core API's own service account (Core API -> orchestrator calls, Phase C1) and the orchestrator's URL.
CORE_API_SERVICE_CLIENT_SECRET=
ORCHESTRATOR_URL=http://localhost:8091
# 8090 is used by other software on some machines; 8091 is the default here.
ORCHESTRATOR_PORT=8091

# Core API
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Comma-separated list of exact origins allowed to call the API from a browser context.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
