# Local development environment for infra/docker/compose.yaml and the Core API.
# Copy to `infra/docker/.env` and set real values. `.env` files are ignored by Git.

# PostgreSQL (container + Core API connection)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_workforce
DB_USERNAME=app_user
# Required. Use a long random value, e.g. `openssl rand -base64 24`.
DB_PASSWORD=

# Core API
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Comma-separated list of exact origins allowed to call the API from a browser context.
# The Angular dev server is http://localhost:4200. See docs/architecture/SECURITY_ARCHITECTURE.md
# for the Electron origin (app://workforce).
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
