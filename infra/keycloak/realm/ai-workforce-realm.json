{
  "realm": "ai-workforce",
  "displayName": "AI Workforce Platform",
  "enabled": true,
  "sslRequired": "external",

  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and maxLength(128)",

  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@aiworkforce.local",
    "fromDisplayName": "AI Workforce Platform",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },

  "clients": [
    {
      "clientId": "ai-workforce-desktop",
      "name": "AI Workforce Desktop",
      "description": "Native desktop application (Electron). Public client: Authorization Code + PKCE S256 through the system browser and a loopback redirect (RFC 8252).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1/logged-out",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "true",
        "client_credentials.use_refresh_token": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "core-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ai-workforce-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ai-workforce-api",
      "name": "AI Workforce Core API",
      "description": "Resource server audience. No login flow is enabled for this client.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
